{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "ahci"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  hardware.firmware = with pkgs; [ linux-firmware ];

  fileSystems."/" = {
    device = "zroot/finix";
    fsType = "zfs";
  };

  fileSystems."/etc" = {
    device = "zroot/etc";
    fsType = "zfs";
  };

  fileSystems."/nix" = {
    device = "zroot/nix";
    fsType = "zfs";
  };

  fileSystems."/var" = {
    device = "zroot/var";
    fsType = "zfs";
  };

  fileSystems."/home" = {
    device = "zroot/home";
    fsType = "zfs";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/A554-6F04";
    fsType = "vfat";
    options = [
      "fmask=0022"
      "dmask=0022"
    ];
  };

  fileSystems = {
    "/server/alt_anime" = {
      device = "192.168.0.231:/export/alt_anime";
      fsType = "nfs";
      options = [
        "defaults"
        "_netdev"
        "hard"
        # "noauto"
      ];
    };

