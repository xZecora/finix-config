{ pkgs, lib, ... }:
let
  cfg = config.programs.fish;
  functionModule =
    with lib;
    types.subModule {
      options = {
        body = mkOption {
          type = types.lines;
          description = ''
            Body of the function.
          '';
        };

        argumentNames = mkOption {
          type = with types; nullOr (either str (listOf str));
          default = null;
        };

        description = mkOption {
          type =  with types; nullOr str;
        };
        
        wraps = mkOption {
          type = with types; nullOr str;
        }
      };
    };
in
{
  options.programs.fish = with lib; {
    enable = mkOption {
      default = false;
      type = types.bool;
      description = ''
        Whether or not to enable the fish shell.
      '';
    };

    package = mkOption {
      default = pkgs.fish;
      type = types.package;
      description = ''
        The package used for the fish shell.
      '';
    };

    interactiveShellInit = mkOption {
      default = "";
      type = types.string;
      description = ''
        Commands to be run when initializing an interactive fish shell.
      '';
    };

    shellAliases = mkOption {
      type = with types; attrsOf string;
      default = { };
      description = ''
        An attribute set that maps aliases (the top level attribute name) to command strings.
      '';
    };

    functions = mkOption {
      type = with types; attrsOf (either lines functionModule);
      default = { };
    };

    # binds = mkOption {
    #   type = types.attrsOf bindModule;
    #   default = { };
    #   description = ''
    #     Manage key bindings.
    #   '';
    # };

  };
}
